<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#161B22"
        android:elevation="4dp"
        app:titleTextColor="#56D364"
        app:subtitleTextColor="#8B949E"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Metadata section ── -->
    <LinearLayout
        android:id="@+id/metaSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161B22"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: name + version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etName"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2"
                android:hint="script-name"
                android:textColor="#E6EDF3"
                android:textColorHint="#484F58"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:background="@null"
                android:inputType="textNoSuggestions"
                android:layout_marginEnd="16dp" />

            <EditText
                android:id="@+id/etVersion"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="1.0"
                android:textColor="#E6EDF3"
                android:textColorHint="#484F58"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:background="@null"
                android:inputType="textNoSuggestions" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#21262D"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp" />

        <!-- Row 2: description + author -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2"
                android:hint="Short description"
                android:textColor="#E6EDF3"
                android:textColorHint="#484F58"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:background="@null"
                android:layout_marginEnd="16dp" />

            <EditText
                android:id="@+id/etAuthor"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="author"
                android:textColor="#E6EDF3"
                android:textColorHint="#484F58"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:background="@null" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/dividerMeta"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#30363D"
        app:layout_constraintTop_toBottomOf="@id/metaSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Code editor ── -->
    <EditText
        android:id="@+id/etCode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="top|start"
        android:textColor="#E6EDF3"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:background="#0D1117"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:isScrollContainer="true"
        app:layout_constraintTop_toBottomOf="@id/dividerMeta"
        app:layout_constraintBottom_toTopOf="@id/symbolBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Symbol shortcut bar ── -->
    <HorizontalScrollView
        android:id="@+id/symbolBar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="#161B22"
        android:scrollbars="none"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toTopOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/symbolContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- ── Status bar ── -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:background="#161B22"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#484F58"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvLineCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#484F58"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Save Package"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#238636"
        style="@style/Widget.AppCompat.Button.Colored"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
