<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#161B22"
        android:elevation="4dp"
        app:titleTextColor="#56D364"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Name + Version row -->
    <LinearLayout
        android:id="@+id/rowMeta1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="script-name"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:background="@null"
            android:inputType="textNoSuggestions"
            android:layout_marginEnd="12dp" />

        <EditText
            android:id="@+id/etVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="version"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:background="@null"
            android:inputType="textNoSuggestions" />
    </LinearLayout>

    <!-- Description + Author row -->
    <LinearLayout
        android:id="@+id/rowMeta2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/rowMeta1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="Short description"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="@null"
            android:layout_marginEnd="12dp" />

        <EditText
            android:id="@+id/etAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="author"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="@null" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#21262D"
        app:layout_constraintTop_toBottomOf="@id/rowMeta2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Code editor -->
    <EditText
        android:id="@+id/etCode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="top|start"
        android:textColor="#E6EDF3"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:background="#0D1117"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:isScrollContainer="true"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Save Package"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#238636"
        android:textAllCaps="false"
        style="@style/Widget.AppCompat.Button.Colored"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
