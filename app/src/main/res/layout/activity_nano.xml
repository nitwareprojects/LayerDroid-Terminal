<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/terminal_bar"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:titleTextColor="@color/terminal_green"
        app:subtitleTextColor="@color/terminal_gray" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/terminal_bg"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal"
            android:fillViewport="true">

            <EditText
                android:id="@+id/etEditor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="300dp"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:padding="8dp"
                android:inputType="textMultiLine|textNoSuggestions"
                android:textColor="@color/terminal_text"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:scrollHorizontally="true"
                android:hint="Comece a digitar..."
                android:textColorHint="@color/terminal_hint" />
        </HorizontalScrollView>
    </ScrollView>

    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/terminal_bar"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[ Pronto ]"
            android:textColor="@color/terminal_green"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvCursor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lin 1, Col 1"
            android:textColor="@color/terminal_gray"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/bottomScroll"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/terminal_bar"
        android:scrollbars="none"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
